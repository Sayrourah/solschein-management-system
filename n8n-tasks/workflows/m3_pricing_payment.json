        {
            "id": "cc3f1516-5b3c-4803-9afc-4e0c5f120d2b",
            "name": "Compute Price",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                220,
                0
            ],
            "parameters": {
                "jsCode": "const b=$input.first().json;const d=b.body||b;const NL=String.fromCharCode(10);const TIERS=[{min:80,s:8},{min:60,s:6},{min:45,s:4},{min:30,s:2},{min:0,s:0}];function support(v){const t=TIERS.find(function(x){return v>=x.min;});return t?t.s:0;}const prod=Number(d.product_total||0);const courier=Number(d.courier_price||0);const cafe_support=support(prod);const delivery_price=Math.max(0,+(courier-cafe_support).toFixed(2));const total=+(prod+delivery_price).toFixed(2);const cur=cafe_support;const nxt=TIERS.slice().reverse().find(function(x){return x.s>cur&&x.min>prod;});let upsell='';if(nxt){const gap=+(nxt.min-prod).toFixed(2);upsell='Add just '+gap+' SAR of products to get a '+nxt.s+' SAR delivery discount instead of '+cur+' SAR. Try a cookie, brownie or extra shot.';}const est=(d.estimated_min!=null)?('Estimated time: '+d.estimated_min+' min'+NL):'';const summary='Order summary'+NL+'Product value: '+prod+' SAR'+NL+'Courier price: '+courier+' SAR'+NL+'Cafe delivery discount: '+cafe_support+' SAR'+NL+'Delivery after discount: '+delivery_price+' SAR'+NL+'Total: '+total+' SAR'+NL+est+(upsell?(upsell+NL):'')+'Reply YES to confirm and receive the payment link.';return [{json:{order_no:String(d.order_no||''),customer_number:String(d.customer_number||''),product_total:prod,courier_price:courier,cafe_support:cafe_support,delivery_price:delivery_price,total:total,status:'Awaiting price approval',summary:summary,upsell:upsell}}];"
            }
        },
