            "parameters": {
                "toolDescription": "Call this ONCE after create_order succeeds for a PICKUP order, to hand the order to the payment flow (Member 3), which sends the customer a payment link. Provide order_no (from create_order), product_total (SAR number) and customer_number.",
                "method": "POST",
                "url": "http://localhost:5678/webhook/m3/checkout",
                "sendBody": true,
                "contentType": "json",
                "specifyBody": "json",
                "jsonBody": "={{ { \"order_no\": $fromAI(\"order_no\", \"the order number returned by create_order\"), \"product_total\": $fromAI(\"product_total\", \"product total in SAR\", \"number\"), \"courier_price\": 0, \"customer_number\": $fromAI(\"customer_number\", \"the customer WhatsApp number\") } }}",
