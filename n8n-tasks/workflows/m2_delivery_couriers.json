        {
            "parameters": {
                "jsCode": "const raw=$input.first().json;const value=raw.messages?raw:((raw.body&&raw.body.entry&&raw.body.entry[0]&&raw.body.entry[0].changes&&raw.body.entry[0].changes[0]&&raw.body.entry[0].changes[0].value)||raw.value||raw);const msg=(value.messages&&value.messages[0])||raw.message||{};const from=msg.from||value.from||raw.from||'';const text=(msg.text&&msg.text.body)||raw.text||'';const loc=msg.location||raw.location||null;function parseCommand(t){t=String(t).trim().toLowerCase();let m;if((m=t.match(/^arrived[ ]+([0-9]+)/)))return{cmd:'arrived',orderNo:m[1]};if((m=t.match(/^picked[ ]*up[ ]+([0-9]+)/)))return{cmd:'picked up',orderNo:m[1]};if((m=t.match(/^near[ ]+([0-9]+)/)))return{cmd:'near',orderNo:m[1]};if((m=t.match(/^deliver[ ]+([0-9]+)[ ]+([0-9]{4})/)))return{cmd:'deliver',orderNo:m[1],code:m[2]};return null;}function parseBid(t){t=String(t);const p=t.match(/([0-9]+(?:[.][0-9]+)?)[ ]*sar/i)||t.match(/([0-9]+(?:[.][0-9]+)?)/);const e=t.match(/([0-9]+)[ ]*min/i);if(!p)return null;return{price:+p[1],etaMin:e?+e[1]:null};}const command=parseCommand(text);const bid=command?null:parseBid(text);let route='other';if(loc)route='location';else if(command)route='command';else if(bid)route='bid';return [{json:{from:from,text:text,hasLocation:!!loc,lat:loc?Number(loc.latitude):null,lng:loc?Number(loc.longitude):null,route:route,command:command,bid:bid}}];"
            },
