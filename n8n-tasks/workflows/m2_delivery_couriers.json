            "id": "8e300f53-a405-4372-8859-599eafe9f05a",
            "name": "Read Couriers",
            "type": "n8n-nodes-base.dataTable",
            "typeVersion": 1.1,
            "position": [
                672,
                112
            ]
        },
        {
            "parameters": {
                "jsCode": "const NL=String.fromCharCode(10);const CAFE={lat:24.7136,lon:46.6753};function hav(a,b){const R=6371,r=function(d){return d*Math.PI/180;};const dLat=r(b.lat-a.lat),dLon=r(b.lon-a.lon);const s=Math.pow(Math.sin(dLat/2),2)+Math.cos(r(a.lat))*Math.cos(r(b.lat))*Math.pow(Math.sin(dLon/2),2);return R*2*Math.atan2(Math.sqrt(s),Math.sqrt(1-s));}function estimate(km){const low=Math.round(6+2.8*km);return{distanceKm:+km.toFixed(2),low:low,high:low+5,minutes:10+Math.round(km/0.5)};}function pick(cs,nb,n){const serves=function(c){return String(c.neighborhoods||'').toLowerCase().split(',').map(function(s){return s.trim();}).indexOf(String(nb||'').toLowerCase())>=0;};const rank=function(a,b){return (b.rating||0)-(a.rating||0)||(a.cancellations||0)-(b.cancellations||0)||(b.completed_orders||0)-(a.completed_orders||0);};const local=cs.filter(serves).sort(rank);const rest=cs.filter(function(c){return !serves(c);}).sort(rank);return local.concat(rest).slice(0,n);}const info=$('Classify Inbound').first().json;const couriers=$input.all().map(function(i){return i.json;});const est=estimate(hav(CAFE,{lat:info.lat,lon:info.lng}));const chosen=pick(couriers,'',5);const requestNo=String(Date.now()).slice(-4);const sd=$getWorkflowStaticData('global');sd.pendingBids=sd.pendingBids||{};sd.pendingBids[info.from]={requestNo:requestNo,distanceKm:est.distanceKm,couriers:chosen.map(function(c){return c.number;}),offers:[],startedAt:Date.now(),customer:info.from};const out=[];out.push({json:{to:info.from,body:'Delivery estimate: '+est.low+' to '+est.high+' SAR, about '+est.minutes+' min. Finding you the best courier...'}});chosen.forEach(function(c){out.push({json:{to:c.number,body:'Solschein delivery request #'+requestNo+NL+'Pickup: Cafe Solschein'+NL+'Drop-off: ~'+est.distanceKm+' km away'+NL+'Ready in: 12 min'+NL+'Reply with price + arrival time (e.g. 15 SAR, arrive in 10 min).'}});});return out;"
            },
