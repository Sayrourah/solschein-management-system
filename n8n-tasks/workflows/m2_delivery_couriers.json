        {
            "parameters": {
                "jsCode": "const info=$('Classify Inbound').first().json;const cmd=info.command;const order=$input.first()?$input.first().json:null;const from=info.from;const MAP={arrived:'Courier arrived','picked up':'Picked up',near:'Courier near',deliver:'Delivered'};let valid=true,status=MAP[cmd.cmd]||null;if(cmd.cmd==='deliver'){valid=!!(order&&String(order.delivery_code)===String(cmd.code).trim());if(!valid)status='Problem';}const customer=order?order.customer_number:null;const messages=[];if(cmd.cmd==='arrived'){messages.push({to:from,body:'Got it - arrived at the cafe for order '+cmd.orderNo+'.'});}if(cmd.cmd==='picked up'){messages.push({to:from,body:'Order '+cmd.orderNo+' picked up. Deliver to the saved address. Send near '+cmd.orderNo+' when close.'});if(customer)messages.push({to:customer,body:'Your order '+cmd.orderNo+' is on the way!'});}if(cmd.cmd==='near'){if(customer){messages.push({to:from,body:'Customer contact: '+customer+'. Final delivery instructions apply.'});messages.push({to:customer,body:'Your courier is nearby for order '+cmd.orderNo+'. Please have your 4-digit code ready.'});}}if(cmd.cmd==='deliver'){if(valid&&customer){messages.push({to:customer,body:'Order '+cmd.orderNo+' delivered. Thank you! Reply 1-5 to rate.'});messages.push({to:from,body:'Delivery confirmed for '+cmd.orderNo+'. Thank you!'});}else{messages.push({to:from,body:'Code mismatch for order '+cmd.orderNo+'. Re-check the 4-digit code with the customer.'});}}return [{json:{order_no:cmd.orderNo,status:status,valid:valid,deliver:cmd.cmd==='deliver',courier_number:(order&&order.courier_number)||from,customer:customer,messages:messages}}];"
            },
            "id": "10f64f1b-41d2-44fb-80e5-1e1bbeaf8ad6",
            "name": "Apply Command",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                880,
                400
            ]
        },
        {
            "parameters": {
                "jsCode": "function score(o,s){s=s||{};const price=(o.price==null?999:o.price),eta=(o.etaMin==null?30:o.etaMin),rating=(s.rating==null?3:s.rating),cancels=(s.cancellations||0);return price*1.0+eta*0.5+(5-rating)*2.0+cancels*3.0;}function choose(offers,st){st=st||{};if(!offers.length)return{winner:null,losers:[]};const sc=offers.map(function(o){return Object.assign({},o,{score:+score(o,st[o.courier_number]).toFixed(2)});}).sort(function(a,b){return a.score-b.score;});return{winner:sc[0],losers:sc.slice(1)};}const info=$('Classify Inbound').first().json;const courierNo=info.from;const bid=info.bid;const sd=$getWorkflowStaticData('global');sd.pendingBids=sd.pendingBids||{};const key=Object.keys(sd.pendingBids).find(function(k){return (sd.pendingBids[k].couriers||[]).indexOf(courierNo)>=0;});if(!key)return [];const req=sd.pendingBids[key];req.offers=req.offers||[];if(!req.offers.some(function(o){return o.courier_number===courierNo;}))req.offers.push({courier_number:courierNo,price:bid.price,etaMin:bid.etaMin});const elapsed=(Date.now()-(req.startedAt||0))>=120000;const allIn=req.offers.length>=(req.couriers||[]).length;if(!(elapsed||allIn))return [];const res=choose(req.offers,{});const winner=res.winner,losers=res.losers;const code=String(Math.floor(1000+Math.random()*9000));delete sd.pendingBids[key];const out=[];if(winner){out.push({json:{to:winner.courier_number,body:'Request #'+req.requestNo+' confirmed. Pickup: Cafe Solschein. Ready in 12 min. On arrival send: arrived '+req.requestNo}});losers.forEach(function(l){out.push({json:{to:l.courier_number,body:'Request #'+req.requestNo+' was assigned to another courier. Thank you.'}});});out.push({json:{to:req.customer,body:'Courier found! Delivery '+winner.price+' SAR (final price set at checkout). Your delivery code is '+code+' - give it to the courier on arrival.'}});}return out;"
            },
