        {
            "id": "a2359546-fcf5-4036-b609-37a16862be0a",
            "name": "Compute Deductions",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                900,
                110
            ],
            "parameters": {
                "jsCode": "const ev=$('Normalize Event').first().json;let items=ev.items;if(typeof items==='string'){try{items=JSON.parse(items||'[]');}catch(e){items=[];}}const products=$('Read Products').all().map(function(i){return i.json;});const inventory=$input.all().map(function(i){return i.json;});const bySku={};products.forEach(function(p){bySku[p.sku]=p;});const byName={};inventory.forEach(function(v){byName[v.name]=v;});const deductions={};function addRecipe(sku,qty){const p=bySku[sku];if(!p||!p.recipe)return;let rec=p.recipe;if(typeof rec==='string'){try{rec=JSON.parse(rec||'[]');}catch(e){rec=[];}}rec.forEach(function(r){deductions[r.item]=(deductions[r.item]||0)+Number(r.qty||0)*qty;});}items.forEach(function(line){const q=Number(line.qty||1);addRecipe(line.sku,q);(line.addons||[]).forEach(function(a){addRecipe(a,q);});});const out=[];Object.keys(deductions).forEach(function(item){const inv=byName[item];if(!inv)return;const newStock=Number(inv.qty_in_stock||0)-deductions[item];out.push({json:{target:'inventory',name:item,qty_in_stock:newStock}});if(newStock<=0){products.forEach(function(p){if(p.is_addon)return;let rec=p.recipe;if(typeof rec==='string'){try{rec=JSON.parse(rec||'[]');}catch(e){rec=[];}}if((rec||[]).some(function(r){return r.item===item;})){out.push({json:{target:'product',sku:p.sku,available:false}});}});}});return out;"
            }
        },
